{
  "name": "@gest0r1/openchamber-telegram-notifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.1"
    },
    "contributes": {
      "panel": {
        "id": "telegram-notifier",
        "name": "Telegram Notifications",
        "icon": "notification-3"
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "keepRunning": true,
        "provides": [
          "opencode"
        ]
      },
      "sessionEvents": {
        "events": [
          "turn-started",
          "turn-finished",
          "turn-failed",
          "permission-asked",
          "question-asked",
          "session-deleted"
        ]
      }
    }
  },
  "scripts": {
    "test": "node --test service/reconcile.test.js service/http.test.js"
  }
}
